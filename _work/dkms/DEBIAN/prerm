#!/bin/sh

PACKAGE_NAME="lisuangpu-dkms"
PACKAGE_VERSION="262.2.0.56"

probe_conf_file="/etc/modules-load.d/gf.conf"
option_conf_file="/etc/modprobe.d/gf.conf"

set -e

case "$1" in
	remove|deconfigure|upgrade)
		if [ "$(dkms status -m $PACKAGE_NAME)" ]; then
			dkms remove -m $PACKAGE_NAME -v $PACKAGE_VERSION --all
		fi
		rm -f "$probe_conf_file"
		rm -f "$option_conf_file"
		depmod -a
		distro_id=""

		if [ -f /etc/os-release ]; then
			distro_id=$(grep "^ID=" /etc/os-release | cut -d= -f2 | tr -d '"')
		fi

		if [ "$distro_id" = "uos" ]; then
			if command -v update-initramfs >/dev/null 2>&1; then
				update-initramfs -u -k "$(uname -r)"
			fi
		fi
		;;

	failed-upgrade)
		;;

	*)
		echo "prerm called with unknown argument \`$1'" >&2
		exit 1
		;;
esac



exit 0
