#!/bin/bash

set -e

PACKAGE_NAME="lisuangpu-dkms"
PACKAGE_VERSION="262.2.0.56"
ARCH=$(dpkg --print-architecture)

probe_conf_file="/etc/modules-load.d/gf.conf"
TMPDIR="/var/tmp"
name=gf

option_conf_file="/etc/modprobe.d/gf.conf"
option_conf="options gf dump_rb_cmd=0 cpu_update_pte=0 paging_rb=1 mhb_disable_mask=0x0 cluster_slice_mask=0xFFFFFF recovery_enable=1 no_vem=0 no_video=0 bypass_only=0 print_level=2 validation_chip=0"

LOG_TAG="[lisuangpu-postinst]"

log_info() {
    echo "$LOG_TAG [INFO] $1"
}

log_warn() {
    echo "$LOG_TAG [WARNING] $1" >&2
}

log_error() {
    echo "$LOG_TAG [ERROR] $1" >&2
}

prompt_gdm_restart() {
    local dm=""
    local distro_id=""

    if [ -f /etc/os-release ]; then
        distro_id=$(grep "^ID=" /etc/os-release | cut -d= -f2 | tr -d '"')
    fi

    log_info "Detected distribution ID: $distro_id"

    if command -v systemctl &>/dev/null; then
        if [ "$distro_id" = "ubuntu" ]; then
            if systemctl list-units --type=service | grep -q gdm; then
                dm="gdm"
            else
                log_warn "Expected gdm for Ubuntu, but gdm service not found."
            fi
        else
            log_info "Unsupported distribution ($distro_id). Skipping display manager restart prompt."
            return
        fi
    fi

    if [ -n "$dm" ]; then
        echo ""
        echo "$LOG_TAG [NOTICE] Driver installation completed."
        echo "$LOG_TAG [NOTICE] $dm is currently running."
        echo "$LOG_TAG [NOTICE] It's recommended to restart $dm to ensure the driver is fully loaded."
        echo "$LOG_TAG [NOTICE] Do you want to restart $dm now? [y/N]"

        read -r answer
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            log_info "User confirmed to restart $dm..."
            if ! systemctl restart "$dm"; then
                log_warn "Failed to restart $dm. Please restart manually or re-login to apply changes."
            fi
        else
            log_info "User chose not to restart $dm now."
        fi
    else
        log_info "No suitable display manager found for restart."
    fi
}

module_configure() {
    local first_install=0
    local distro_id=""

    if [ -f /etc/os-release ]; then
        distro_id=$(grep "^ID=" /etc/os-release | cut -d= -f2 | tr -d '"')
    fi
    
    #log_info "Checking if module $name is already loaded..."

    #if lsmod | grep -q "$name"; then
    #    log_info "Module $name is already loaded. Skipping modprobe."
    #else
    #    log_info "Module $name not loaded. Attempting to load..."
    #    if ! modprobe "$name"; then
    #        log_warn "Failed to modprobe $name. "
    #        exit 1
    #    else
    #        log_info "Module $name loaded successfully."
    #        first_install=1
    #    fi
    #fi

    echo "$name" > "$probe_conf_file"
    echo "$option_conf" > "$option_conf_file"
    
    if [ "$distro_id" = "uos" ]; then
        if command -v update-initramfs >/dev/null 2>&1; then
            update-initramfs -u -k "$(uname -r)"
        fi
    fi
    
    #if [ "$first_install" -eq 1 ]; then
    #    prompt_gdm_restart
    #fi
}

dkms_configure () { 
    local rc
    local name mver kver status
    for POSTINST in /usr/lib/dkms/common.postinst; do
        if [ -f "$POSTINST" ]; then
	    echo "blacklist gf" >/etc/modprobe.d/blacklist-gf.conf
            "$POSTINST" "$PACKAGE_NAME" "$PACKAGE_VERSION" "/usr/share/$PACKAGE_NAME" "$ARCH" "$2"
	    rm -f /etc/modprobe.d/blacklist-gf.conf
	    rc=$?
            if [ $rc -eq 0 ]; then
                echo -n >${TMPDIR}/${PACKAGE_NAME}-kernels
                while IFS=" /," read name mver kver status; do
                    if [ -z "${status##*installed*}" ]; then
                        echo "[INFO] Found installed module for kernel: $kver"
                        update-initramfs -u -k "$kver" 2>/dev/null || true
                        echo "$kver" >>${TMPDIR}/${PACKAGE_NAME}-kernels
                    fi
                done <<< "$(dkms status "$PACKAGE_NAME/$PACKAGE_VERSION")"
            fi
            return $rc
        fi
    done
    if [ "$(id -u)" -ne 0 ]; then
        echo "Error: Package installation requires root privileges"
        return 1
    fi
    return 0
}

case "$1" in
    configure)
        log_info "Running postinst configure..."
        dkms_configure || log_warn "dkms_configure failed but continuing"
        module_configure
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        log_info "postinst: $1 triggered. No action taken."
        ;;
    *)
        log_error "postinst called with unknown argument \`$1'"
        exit 1
        ;;
esac

exit 0
